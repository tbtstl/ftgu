# Copy to server/.env (which git ignores) and fill in.

# Privy (sign-in): app ID and secret from the Privy dashboard.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# The feature flag: the API answers only when this is true.
MENTOR_ENABLED=true

# Payfer (paid messages): both key pairs from your app in the Payfer dashboard. PAYFER_MODE picks
# the pair (test unless it says live); the server hands the matching publishable key to the site.
PAYFER_MODE=test
PAYFER_TEST_PK=
PAYFER_TEST_SK=
PAYFER_LIVE_PK=
PAYFER_LIVE_SK=

# Claude (answers): an API key from the Claude Console. Sonnet 5.5 at low effort costs about 1¢ an
# answer, about the 1¢ charge; Haiku 5.5 at high effort is about 0.1¢, and Opus 5.5 about 2¢.
ANTHROPIC_API_KEY=
MENTOR_MODEL=claude-sonnet-5-5
MENTOR_EFFORT=low

# Where the site runs (comma-separated), and where this server listens and keeps its data.
SITE_ORIGIN=http://localhost:5173
PORT=8787
DATABASE_PATH=server/data/mentor.db
