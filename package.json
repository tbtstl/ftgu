{
  "name": "energy-market-course",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:live": "vite --mode live",
    "server": "tsx watch --env-file=server/.env server/src/index.ts",
    "server:start": "tsx server/src/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@hono/node-server": "^2.1.5",
    "@privy-io/js-sdk-core": "^0.78.3",
    "@privy-io/node": "^0.35.0",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.13.14",
    "payfer": "^0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.15",
    "viem": "^2.57.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.9.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}
